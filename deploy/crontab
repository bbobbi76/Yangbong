# VM에 설치: crontab deploy/crontab 과 같은 내용 (스크립트는 ~/bin 복사본을 씀 — 실행 중 checkout으로 바뀌지 않게)
50 8 * * 1-5 $HOME/bin/vm_update.sh
2 9 * * 1-5 $HOME/bin/vm_run.sh surge
5 9 * * 1-5 $HOME/bin/vm_run.sh rebalance
# 1위 굳히기 확인: 다른 팀 최고보다 2%p 앞서면 C 전량 현금화 (조건 안 되면 리더보드 1회 조회만)
0,30 10-14 * * 1-5 $HOME/bin/vm_run.sh rebalance --lock-only
